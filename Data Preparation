{"cells":[{"cell_type":"code","execution_count":1,"id":"279c5e2d","metadata":{"execution":{"iopub.execute_input":"2026-10-05T18:24:40.094133Z","iopub.status.busy":"2026-10-05T18:24:40.093767Z","iopub.status.idle":"2026-10-05T18:24:42.949307Z","shell.execute_reply":"2026-10-05T18:24:42.94839Z"},"papermill":{"duration":2.861526,"end_time":"2026-10-05T18:24:42.951502+00:00","exception":false,"start_time":"2026-10-05T18:24:40.089976+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import os\n","import random\n","from collections import Counter\n","from pathlib import Path\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from PIL import Image, ImageOps\n","from sklearn.model_selection import train_test_split\n","\n","# ---------------- Settings ----------------\n","DATA_ROOT  = Path(\"/kaggle/input\")          # folder that contains the class folders (change if needed)\n","OUTPUT_DIR = Path(\"/kaggle/working/data_64\")  # where the 64x64 images are saved\n","IMG_SIZE   = (64, 64)                        # target size (assignment maximum)\n","SEED       = 42                              # fixed seed -> same split for every model\n","IMG_EXTS   = {\".jpg\"}\n","\n","random.seed(SEED)\n","np.random.seed(SEED)"]},{"cell_type":"markdown","id":"e2488710","metadata":{"papermill":{"duration":0.001856,"end_time":"2026-10-05T18:24:42.955479+00:00","exception":false,"start_time":"2026-10-05T18:24:42.953623+00:00","status":"completed"},"tags":[]},"source":["## 1. Find all images and their class labels"]},{"cell_type":"code","execution_count":2,"id":"b8110aaa","metadata":{"execution":{"iopub.execute_input":"2026-10-05T18:24:42.960773Z","iopub.status.busy":"2026-10-05T18:24:42.960223Z","iopub.status.idle":"2026-10-05T18:24:53.634589Z","shell.execute_reply":"2026-10-05T18:24:53.633464Z"},"papermill":{"duration":10.679283,"end_time":"2026-10-05T18:24:53.636561+00:00","exception":false,"start_time":"2026-10-05T18:24:42.957278+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Found 3000 images in 3 classes:\n","  cats                 1000\n","  dogs                 1000\n","  snakes               1000\n"]}],"source":["paths, labels = [], []\n","for root, _, files in os.walk(DATA_ROOT):\n","    for f in sorted(files):\n","        if Path(f).suffix.lower() in IMG_EXTS:\n","            paths.append(os.path.join(root, f))\n","            labels.append(Path(root).name.lower())   # folder name = class\n","\n","classes = sorted(set(labels))\n","print(f\"Found {len(paths)} images in {len(classes)} classes:\")\n","for c, n in sorted(Counter(labels).items()):\n","    print(f\"  {c:<20} {n}\")"]},{"cell_type":"markdown","id":"d265024b","metadata":{"papermill":{"duration":0.001525,"end_time":"2026-10-05T18:24:53.63984+00:00","exception":false,"start_time":"2026-10-05T18:24:53.638315+00:00","status":"completed"},"tags":[]},"source":["## 4. Downscale to 64 × 64 and save\n","- `ImageOps.fit` centre-crops to a square first (so non-square images are not stretched), then resizes.\n","- `Image.LANCZOS` applies an **anti-aliasing (low-pass) filter**, so no extra filter is needed.\n","- Saved as PNG to avoid adding JPEG compression artefacts."]},{"cell_type":"code","execution_count":3,"id":"ae04f5b7","metadata":{"execution":{"iopub.execute_input":"2026-10-05T18:24:53.644717Z","iopub.status.busy":"2026-10-05T18:24:53.64434Z","iopub.status.idle":"2026-10-05T18:25:25.309698Z","shell.execute_reply":"2026-10-05T18:25:25.308395Z"},"papermill":{"duration":31.671455,"end_time":"2026-10-05T18:25:25.312923+00:00","exception":false,"start_time":"2026-10-05T18:24:53.641468+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Downscaled 3000 images to 64x64 -> /kaggle/working/data_64/all\n"]}],"source":["import shutil\n","\n","shutil.rmtree(OUTPUT_DIR, ignore_errors=True)   # start clean, so re-running never leaves old/duplicate files\n","ALL_DIR = OUTPUT_DIR / \"all\"\n","\n","def downscale(src, dst):\n","    img = Image.open(src)\n","    img = ImageOps.exif_transpose(img).convert(\"RGB\")       # fix rotation, force 3 channels\n","    img = ImageOps.fit(img, IMG_SIZE, method=Image.LANCZOS)  # crop to square + anti-aliased resize\n","    img.save(dst)\n","\n","small_paths = []                                  # paths of the 64x64 images, same order as `labels`\n","for i, (src, cls) in enumerate(zip(paths, labels)):\n","    out_dir = ALL_DIR / cls\n","    out_dir.mkdir(parents=True, exist_ok=True)\n","    dst = out_dir / f\"{cls}_{i:05d}.png\"\n","    downscale(src, dst)\n","    small_paths.append(dst)\n","\n","print(f\"Downscaled {len(small_paths)} images to {IMG_SIZE[0]}x{IMG_SIZE[1]} -> {ALL_DIR}\")"]},{"cell_type":"markdown","id":"7b974a54","metadata":{"papermill":{"duration":0.002038,"end_time":"2026-10-05T18:25:25.317155+00:00","exception":false,"start_time":"2026-10-05T18:25:25.315117+00:00","status":"completed"},"tags":[]},"source":["## 3. Stratified split: 70% train, 15% validation, 15% test\n","`stratify` keeps the same class proportions in every split."]},{"cell_type":"code","execution_count":4,"id":"043dc9b9","metadata":{"execution":{"iopub.execute_input":"2026-10-05T18:25:25.322797Z","iopub.status.busy":"2026-10-05T18:25:25.322419Z","iopub.status.idle":"2026-10-05T18:25:25.804606Z","shell.execute_reply":"2026-10-05T18:25:25.802284Z"},"papermill":{"duration":0.487976,"end_time":"2026-10-05T18:25:25.80687+00:00","exception":false,"start_time":"2026-10-05T18:25:25.318894+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["train:   2100 images  {'cats': 700, 'dogs': 700, 'snakes': 700}\n","val  :    450 images  {'cats': 150, 'dogs': 150, 'snakes': 150}\n","test :    450 images  {'cats': 150, 'dogs': 150, 'snakes': 150}\n"]}],"source":["train_p, temp_p, train_y, temp_y = train_test_split(\n","    small_paths, labels, test_size=0.30, stratify=labels, random_state=SEED)\n","val_p, test_p, val_y, test_y = train_test_split(\n","    temp_p, temp_y, test_size=0.50, stratify=temp_y, random_state=SEED)\n","\n","splits = {\"train\": (train_p, train_y), \"val\": (val_p, val_y), \"test\": (test_p, test_y)}\n","for name, (p_list, y_list) in splits.items():\n","    for src, cls in zip(p_list, y_list):\n","        out_dir = OUTPUT_DIR / name / cls\n","        out_dir.mkdir(parents=True, exist_ok=True)\n","        shutil.copy(src, out_dir / src.name)\n","    print(f\"{name:<5}: {len(p_list):>6} images  {dict(sorted(Counter(y_list).items()))}\")"]},{"cell_type":"markdown","id":"30009c08","metadata":{"papermill":{"duration":0.001657,"end_time":"2026-10-05T18:25:25.810331+00:00","exception":false,"start_time":"2026-10-05T18:25:25.808674+00:00","status":"completed"},"tags":[]},"source":["## 6. Before / after figure (for the report)"]},{"cell_type":"code","execution_count":5,"id":"e9f36232","metadata":{"execution":{"iopub.execute_input":"2026-10-05T18:25:25.815419Z","iopub.status.busy":"2026-10-05T18:25:25.815023Z","iopub.status.idle":"2026-10-05T18:25:26.711099Z","shell.execute_reply":"2026-10-05T18:25:26.710129Z"},"papermill":{"duration":0.90635,"end_time":"2026-10-05T18:25:26.718376+00:00","exception":false,"start_time":"2026-10-05T18:25:25.812026+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 900x600 with 6 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["n = min(5, len(classes))\n","fig, axes = plt.subplots(2, n, figsize=(3 * n, 6))\n","axes = np.array(axes).reshape(2, -1)\n","for j, cls in enumerate(classes[:n]):\n","    i = labels.index(cls)                                                  # first image of this class\n","    orig = ImageOps.exif_transpose(Image.open(paths[i])).convert(\"RGB\")     # original\n","    small = Image.open(small_paths[i])                                      # its saved 64x64 version\n","    axes[0, j].imshow(orig);  axes[0, j].set_title(f\"{cls}\\n{orig.size[0]}x{orig.size[1]}\")\n","    axes[1, j].imshow(small); axes[1, j].set_title(f\"64x64\")\n","    axes[0, j].axis(\"off\");   axes[1, j].axis(\"off\")\n","plt.suptitle(\"Original (top) vs downscaled to 64x64 (bottom)\")\n","plt.tight_layout()\n","plt.savefig(\"/kaggle/working/before_after.png\", dpi=150)\n","plt.show()"]},{"cell_type":"markdown","id":"c401fd00","metadata":{"papermill":{"duration":0.004614,"end_time":"2026-10-05T18:25:26.728191+00:00","exception":false,"start_time":"2026-10-05T18:25:26.723577+00:00","status":"completed"},"tags":[]},"source":["## 7. Load the 64 × 64 data for training\n","Every model (A, B, MobileNet, EfficientNet) should load from these same folders, so they all use the same split."]},{"cell_type":"code","execution_count":6,"id":"1b99a3e6","metadata":{"execution":{"iopub.execute_input":"2026-10-05T18:25:26.739245Z","iopub.status.busy":"2026-10-05T18:25:26.738861Z","iopub.status.idle":"2026-10-05T18:25:46.81184Z","shell.execute_reply":"2026-10-05T18:25:46.810802Z"},"papermill":{"duration":20.080963,"end_time":"2026-10-05T18:25:46.81381+00:00","exception":false,"start_time":"2026-10-05T18:25:26.732847+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Found 2100 files belonging to 3 classes.\n","Found 450 files belonging to 3 classes.\n","Found 450 files belonging to 3 classes.\n","Classes: ['cats', 'dogs', 'snakes']\n"]},{"name":"stderr","output_type":"stream","text":["2026-10-05 18:25:46.573664: E external/local_xla/xla/stream_executor/cuda/cuda_platform.cc:51] failed call to cuInit: INTERNAL: CUDA error: Failed call to cuInit: UNKNOWN ERROR (303)\n"]}],"source":["# TensorFlow / Keras\n","import tensorflow as tf\n","\n","BATCH = 32\n","train_ds = tf.keras.utils.image_dataset_from_directory(\n","    OUTPUT_DIR / \"train\", image_size=IMG_SIZE, batch_size=BATCH, seed=SEED, shuffle=True)\n","val_ds = tf.keras.utils.image_dataset_from_directory(\n","    OUTPUT_DIR 