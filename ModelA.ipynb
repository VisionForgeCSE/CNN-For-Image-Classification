    "## 4. Evaluation on the test set\n",
    "\n",
    "The test set is used **only here**, once, after all choices were made on the validation set.\n",
    "Test-time augmentation (TTA) averages the prediction for each image and its mirror image."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell15",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.metrics import (confusion_matrix, classification_report, ConfusionMatrixDisplay,\n",
    "                             accuracy_score, precision_recall_fscore_support)\n",
    "\n",
    "def predict_probs(model, ds, tta=True):\n",
    "    probs = model.predict(ds, verbose=0)\n",
    "    if tta:\n",
    "        probs = (probs + model.predict(ds.map(lambda x, y: (tf.image.flip_left_right(x), y)), verbose=0)) / 2\n",
    "    return probs\n",
    "\n",
    "def evaluate(model, ds, title, tta=True):\n",
    "    y_true = np.concatenate([y.numpy() for _, y in ds])\n",
    "    y_pred = np.argmax(predict_probs(model, ds, tta), axis=1)\n",
    "\n",
    "    acc = accuracy_score(y_true, y_pred)\n",
    "    p, r, f1, _ = precision_recall_fscore_support(y_true, y_pred, average=\"weighted\", zero_division=0)\n",
    "    summary = pd.DataFrame({\"Metric\": [\"Test accuracy\", \"Precision (weighted)\", \"Recall (weighted)\", \"F1-score (weighted)\"],\n",
    "                            \"Value\": [acc, p, r, f1]})\n",
    "    print(summary.to_string(index=False, float_format=\"{:.4f}\".format), \"\\n\")\n",
    "    print(classification_report(y_true, y_pred, target_names=CLASS_NAMES, digits=4, zero_division=0))\n",
    "\n",
    "    cm = confusion_matrix(y_true, y_pred)\n",
    "    fig, ax = plt.subplots(1, 2, figsize=(12, 5))\n",
    "    ConfusionMatrixDisplay(cm, display_labels=CLASS_NAMES).plot(ax=ax[0], cmap=\"Blues\", values_format=\"d\", colorbar=False)\n",
    "    ax[0].set_title(f\"{title} – confusion matrix (counts)\")\n",
    "    ConfusionMatrixDisplay(cm / cm.sum(axis=1, keepdims=True), display_labels=CLASS_NAMES).plot(\n",
    "        ax=ax[1], cmap=\"Blues\", values_format=\".2f\", colorbar=False)\n",
    "    ax[1].set_title(f\"{title} – confusion matrix (normalised)\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(WORK_DIR / \"Model_A_confusion.png\", dpi=150, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "    return acc\n",
    "\n",
    "y_val = np.concatenate([y.numpy() for _, y in val_ds_n])\n",
    "print(f\"Validation accuracy without TTA: {np.mean(np.argmax(predict_probs(model_a, val_ds_n, False), 1) == y_val):.4f}\")\n",
    "print(f\"Validation accuracy with TTA   : {np.mean(np.argmax(predict_probs(model_a, val_ds_n, True), 1) == y_val):.4f}\\n\")\n",
    "\n",
    "test_acc_a = evaluate(model_a, test_ds_n, \"Model A\", tta=True)"
   ]
