    "# Parameters and multiply-accumulate operations (MACs) per layer\n",
    "def count_cost(model):\n",
    "    rows = []\n",
    "    for layer in model.layers:\n",
    "        if isinstance(layer, layers.Conv2D):\n",
    "            h, w, c_out = layer.output.shape[1:]\n",
    "            c_in = layer.input.shape[-1]\n",
    "            kh, kw = layer.kernel_size\n",
    "            rows.append((f\"Conv2D {kh}x{kw}, {c_out} ({h}x{w})\", layer.count_params(), h * w * kh * kw * c_in * c_out))\n",
    "        elif isinstance(layer, layers.Dense):\n",
    "            n_in, n_out = layer.input.shape[-1], layer.units\n",
    "            rows.append((f\"Dense {n_out}\", layer.count_params(), n_in * n_out))\n",
    "        elif isinstance(layer, layers.BatchNormalization):\n",
    "            rows.append((f\"BatchNorm ({layer.input.shape[-1]})\", layer.count_params(), 0))\n",
    "    return rows\n",
    "\n",
    "rows = count_cost(build_model_a())\n",
    "print(f\"{'Layer':<32}{'Params':>12}{'MACs':>16}\")\n",
    "for name, p, m in rows:\n",
    "    print(f\"{name:<32}{p:>12,}{m:>16,}\")\n",
    "total_p = sum(r[1] for r in rows); total_m = sum(r[2] for r in rows)\n",
    "print(f\"{'TOTAL':<32}{total_p:>12,}{total_m:>16,}\")\n",
    "print(\"Keras count:\", f\"{build_model_a().count_params():,}\", \"| match:\", total_p == build_model_a().count_params())"
   ]
