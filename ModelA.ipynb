    "## 2. Optimizer and learning-rate comparison\n",
    "\n",
    "Every run starts from a **freshly built model with the same random seed**, so only the optimizer changes.\n",
    "To keep this affordable, each of the 9 runs gets a **30-epoch budget**; the winner is then trained properly in section 3.\n",
    "\n",
    "- Optimizers: Adam, plain SGD, SGD + Momentum (0.9)\n",
    "- Learning rates: 0.01, 0.001, 0.0005"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "cell07",
   "metadata": {},
   "outputs": [],
   "source": [
    "class EpochTimer(tf.keras.callbacks.Callback):\n",
    "    def on_train_begin(self, logs=None): self.times = []\n",
    "    def on_epoch_begin(self, epoch, logs=None): self._t = time.time()\n",
    "    def on_epoch_end(self, epoch, logs=None): self.times.append(time.time() - self._t)\n",
    "\n",
    "def make_optimizer(name, lr):\n",
    "    if name == \"Adam\":           return tf.keras.optimizers.Adam(learning_rate=lr)\n",
    "    if name == \"SGD\":            return tf.keras.optimizers.SGD(learning_rate=lr)\n",
    "    if name == \"SGD+Momentum\":   return tf.keras.optimizers.SGD(learning_rate=lr, momentum=0.9)\n",
    "    raise ValueError(name)\n",
    "\n",
    "def train_model_a(opt_name, lr, epochs, stop_patience, lr_patience, verbose=0):\n",
    "    tf.keras.backend.clear_session()\n",
    "    tf.keras.utils.set_random_seed(SEED)        # same initial weights for every run\n",
    "    model = build_model_a()\n",
    "    model.compile(optimizer=make_optimizer(opt_name, lr),\n",
    "                  loss=\"sparse_categorical_crossentropy\",\n",
    "                  metrics=[\"accuracy\"])\n",
    "    timer = EpochTimer()\n",
    "    callbacks = [\n",
    "        timer,\n",
    "        tf.keras.callbacks.ReduceLROnPlateau(monitor=\"val_loss\", factor=0.5, patience=lr_patience, min_lr=1e-6),\n",
    "        tf.keras.callbacks.EarlyStopping(monitor=\"val_accuracy\", patience=stop_patience, restore_best_weights=True),\n",
    "    ]\n",
    "    history = model.fit(train_ds_n, validation_data=val_ds_n, epochs=epochs,\n",
    "                        callbacks=callbacks, verbose=verbose)\n",
    "    return model, history, timer"
   ]
  },
